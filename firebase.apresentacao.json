{
  "hosting": {
    "public": "dist-apresentacao",
    "ignore": ["**/.*"],
    "redirects": [{"source": "/", "destination": "/html/", "type": 302}],
    "headers": [{"source": "**", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
      {"key": "Cache-Control", "value": "no-cache"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
    ]}]
  }
}
