rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function bloqueado() { return autenticado() && exists(/databases/$(database)/documents/exclusoes/$(request.auth.uid)); }
    function contaAtiva() { return autenticado() && !bloqueado(); }
    function emailVerificado() { return contaAtiva() && request.auth.token.email_verified == true; }
    function administrador() {
      return emailVerificado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true;
    }
    function professorAutorizado() {
      return emailVerificado() && exists(/databases/$(database)/documents/professores_acesso/$(request.auth.uid))
        && get(/databases/$(database)/documents/professores_acesso/$(request.auth.uid)).data.ativo == true;
    }
    function texto(valor, minimo, maximo) { return valor is string && valor.size() >= minimo && valor.size() <= maximo; }
    function emailDaConta(valor) { return contaAtiva() && valor == request.auth.token.email; }
    function cienciaValida(dados) { return dados.privacidadeVersao == '2026-10-04' && dados.privacidadeCienteEm == request.time; }
    function acessoProfessorValido(dados) {
      return dados.keys().hasOnly(['nome', 'email', 'especialidade', 'ativo', 'criadoEm', 'atualizadoEm', 'atualizadoPor'])
        && texto(dados.nome, 3, 100) && texto(dados.email, 5, 254) && texto(dados.especialidade, 2, 100)
        && dados.ativo is bool && dados.atualizadoEm == request.time && dados.atualizadoPor == request.auth.uid;
    }
    function pedidoPrivacidadeValido(dados, userId) {
      return contaAtiva() && request.auth.uid == userId
        && dados.keys().hasOnly(['usuarioId', 'email', 'tipo', 'status', 'criadoEm', 'atualizadoEm'])
        && dados.usuarioId == userId && emailDaConta(dados.email) && dados.tipo == 'exclusao' && dados.status == 'pendente'
        && dados.criadoEm == request.time && dados.atualizadoEm == request.time;
    }
    match /admins/{userId} {
      allow read: if contaAtiva() && (request.auth.uid == userId || administrador());
      allow write: if false;
    }
    match /professores_acesso/{userId} {
      allow read: if administrador() || (contaAtiva() && request.auth.uid == userId);
      allow create: if administrador() && acessoProfessorValido(request.resource.data) && request.resource.data.criadoEm == request.time;
      allow update: if administrador() && acessoProfessorValido(request.resource.data)
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'email', 'especialidade', 'ativo', 'atualizadoEm', 'atualizadoPor']);
      allow delete: if administrador();
    }
    match /usuarios/{userId} {
      allow create: if contaAtiva() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'papel', 'criadoEm', 'atualizadoEm', 'privacidadeVersao', 'privacidadeCienteEm'])
        && request.resource.data.papel == 'aluno' && emailDaConta(request.resource.data.email)
        && texto(request.resource.data.nome, 3, 100) && texto(request.resource.data.telefone, 8, 20)
        && cienciaValida(request.resource.data) && request.resource.data.criadoEm == request.time && request.resource.data.atualizadoEm == request.time;
      allow read: if contaAtiva() && (request.auth.uid == userId || administrador());
      allow update: if contaAtiva() && (request.auth.uid == userId || administrador())
        && texto(request.resource.data.nome, 3, 100) && texto(request.resource.data.telefone, 8, 20)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'atualizadoEm']);
      allow delete: if false;
    }
    match /agendamentos/{agendamentoId} {
      allow read: if administrador() || (contaAtiva() && resource.data.usuarioId == request.auth.uid);
      // Confirmação, cancelamento e presença passam pelo servidor.
      // O professor recebe uma resposta mínima da função listarAulasProfessor.
      allow write: if false;
    }
    match /contatos/{contatoId} {
      allow create: if (!autenticado() || contaAtiva())
        && request.resource.data.keys().hasOnly(['usuarioId', 'nome', 'email', 'telefone', 'mensagem', 'status', 'criadoEm', 'privacidadeVersao', 'privacidadeCienteEm'])
        && (request.resource.data.usuarioId == null || (contaAtiva() && request.resource.data.usuarioId == request.auth.uid && emailDaConta(request.resource.data.email)))
        && texto(request.resource.data.nome, 3, 100) && texto(request.resource.data.email, 5, 254)
        && texto(request.resource.data.telefone, 0, 20) && texto(request.resource.data.mensagem, 10, 2000)
        && request.resource.data.status == 'novo' && request.resource.data.criadoEm == request.time && cienciaValida(request.resource.data);
      allow read: if administrador();
      allow update: if administrador() && request.resource.data.status in ['novo', 'respondido']
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm']);
      allow delete: if administrador();
    }
    match /configuracoes/{configuracaoId} {
      allow read: if configuracaoId in ['funcionamento', 'privacidade'];
      allow create, update: if administrador() && (
        (configuracaoId == 'funcionamento' && request.resource.data.keys().hasOnly(['dias', 'capacidadePadrao', 'atualizadoEm', 'atualizadoPor'])
          && request.resource.data.dias is map && request.resource.data.capacidadePadrao is int
          && request.resource.data.capacidadePadrao >= 1 && request.resource.data.capacidadePadrao <= 500
          && request.resource.data.atualizadoEm == request.time && request.resource.data.atualizadoPor == request.auth.uid)
        || (configuracaoId == 'privacidade'
          && request.resource.data.keys().hasOnly(['controladorNome', 'controladorDocumento', 'controladorEndereco', 'emailPrivacidade', 'publicada', 'versao', 'agendamentosDias', 'contatosDias', 'auditoriaDias', 'atualizadoEm'])
          && texto(request.resource.data.controladorNome, 3, 150) && texto(request.resource.data.controladorDocumento, 3, 30)
          && texto(request.resource.data.controladorEndereco, 3, 250) && texto(request.resource.data.emailPrivacidade, 5, 254)
          && request.resource.data.publicada is bool && request.resource.data.versao == '2026-10-04'
          && request.resource.data.agendamentosDias is int && request.resource.data.agendamentosDias >= 1 && request.resource.data.agendamentosDias <= 3650
          && request.resource.data.contatosDias is int && request.resource.data.contatosDias >= 1 && request.resource.data.contatosDias <= 3650
          && request.resource.data.auditoriaDias is int && request.resource.data.auditoriaDias >= 1 && request.resource.data.auditoriaDias <= 3650
          && request.resource.data.atualizadoEm == request.time));
      allow delete: if false;
    }
    match /auditoria/{registroId} {
      allow read: if administrador();
      allow create: if administrador()
        && request.resource.data.keys().hasOnly(['adminUid', 'adminEmail', 'acao', 'entidade', 'entidadeId', 'detalhes', 'criadoEm'])
        && request.resource.data.adminUid == request.auth.uid && emailDaConta(request.resource.data.adminEmail)
        && texto(request.resource.data.acao, 2, 80) && texto(request.resource.data.entidade, 2, 80)
        && texto(request.resource.data.entidadeId, 1, 180) && texto(request.resource.data.detalhes, 0, 2000)
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }
    match /solicitacoes_privacidade/{userId} {
      allow create: if pedidoPrivacidadeValido(request.resource.data, userId);
      allow read: if administrador() || (contaAtiva() && request.auth.uid == userId);
      allow update: if resource.data.status == 'atendida' && pedidoPrivacidadeValido(request.resource.data, userId);
      allow delete: if false;
    }
    match /horarios/{horarioId} {
      allow read: if resource.data.ativo == true || administrador()
        || (professorAutorizado() && resource.data.get('professorUid', '') == request.auth.uid);
      allow write: if false;
    }
    match /planos/{id} {
      allow read: if resource.data.ativo == true || administrador();
      allow create, update: if administrador() && texto(request.resource.data.nome, 3, 100)
        && request.resource.data.valor is number && request.resource.data.valor >= 0 && request.resource.data.valor <= 100000
        && request.resource.data.beneficios is list && request.resource.data.beneficios.size() <= 30 && request.resource.data.ativo is bool;
      allow delete: if administrador();
    }
    match /professores/{id} {
      allow read: if resource.data.ativo == true || administrador();
      allow create, update: if administrador() && texto(request.resource.data.nome, 3, 100)
        && texto(request.resource.data.especialidade, 2, 100) && texto(request.resource.data.get('fotoUrl', ''), 0, 2048) && request.resource.data.ativo is bool;
      allow delete: if administrador();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
