rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function emailVerificado() {
      return autenticado() && request.auth.token.email_verified == true;
    }

    function administrador() {
      return emailVerificado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true;
    }

    function textoValido(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    function emailDaConta(valor) {
      return autenticado()
        && request.auth.token.email != null
        && valor == request.auth.token.email;
    }

    function dataHoraValidas(dados) {
      return dados.data is string
        && dados.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dados.hora is string
        && dados.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function agendamentoValido(dados) {
      return dados.keys().hasOnly([
          'usuarioId', 'nome', 'email', 'data', 'hora', 'plano', 'horarioId', 'atividade',
          'status', 'criadoEm', 'atualizadoEm'
        ])
        && dados.usuarioId == request.auth.uid
        && emailDaConta(dados.email)
        && textoValido(dados.nome, 3, 100)
        && textoValido(dados.plano, 3, 100)
        && textoValido(dados.horarioId, 3, 150)
        && textoValido(dados.atividade, 3, 100)
        && dataHoraValidas(dados);
    }

    function horarioValido(dados) {
      return dados.keys().hasOnly([
          'hora', 'atividade', 'capacidade', 'diasSemana', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && dados.hora is string
        && dados.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && textoValido(dados.atividade, 2, 100)
        && dados.get('capacidade', 20) is int
        && dados.get('capacidade', 20) >= 1
        && dados.get('capacidade', 20) <= 500
        && dados.get('diasSemana', [1, 2, 3, 4, 5, 6]) is list
        && dados.get('diasSemana', [1, 2, 3, 4, 5, 6]).size() >= 1
        && dados.get('diasSemana', [1, 2, 3, 4, 5, 6]).size() <= 7
        && dados.ativo is bool;
    }

    match /admins/{userId} {
      allow read: if autenticado() && (request.auth.uid == userId || administrador());
      allow write: if false;
    }

    match /usuarios/{userId} {
      allow create: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'nome', 'email', 'telefone', 'papel', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.papel == 'aluno'
        && emailDaConta(request.resource.data.email)
        && textoValido(request.resource.data.nome, 3, 100)
        && textoValido(request.resource.data.telefone, 8, 20)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      allow read: if autenticado() && (request.auth.uid == userId || administrador());

      allow update: if administrador() || (
        autenticado()
        && request.auth.uid == userId
        && request.resource.data.get('papel', 'aluno') == resource.data.get('papel', 'aluno')
        && request.resource.data.email == resource.data.email
        && textoValido(request.resource.data.nome, 3, 100)
        && textoValido(request.resource.data.telefone, 8, 20)
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'telefone', 'atualizadoEm'])
      );

      allow delete: if administrador() || (autenticado() && request.auth.uid == userId);
    }

    match /agendamentos/{agendamentoId} {
      allow create: if emailVerificado()
        && agendamentoValido(request.resource.data)
        && agendamentoId == request.auth.uid + '_' + request.resource.data.data + '_' + request.resource.data.hora
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      allow read: if administrador()
        || (autenticado() && resource.data.usuarioId == request.auth.uid);

      allow update: if (administrador()
        && request.resource.data.status in ['pendente', 'confirmado', 'lista_espera', 'cancelado', 'recusado']
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm', 'atualizadoPor']))
        || (autenticado()
          && resource.data.usuarioId == request.auth.uid
          && request.resource.data.atualizadoEm == request.time
          && request.resource.data.status == 'cancelado'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'atualizadoEm']))
        || (emailVerificado()
          && resource.data.usuarioId == request.auth.uid
          && resource.data.status in ['cancelado', 'recusado']
          && request.resource.data.status == 'pendente'
          && agendamentoId == request.auth.uid + '_' + resource.data.data + '_' + resource.data.hora
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.data == resource.data.data
          && request.resource.data.hora == resource.data.hora
          && emailDaConta(request.resource.data.email)
          && textoValido(request.resource.data.nome, 3, 100)
          && textoValido(request.resource.data.plano, 3, 100)
          && textoValido(request.resource.data.horarioId, 3, 150)
          && textoValido(request.resource.data.atividade, 3, 100)
          && request.resource.data.atualizadoEm == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nome', 'email', 'plano', 'horarioId', 'atividade', 'status', 'atualizadoEm']));

      allow delete: if administrador();
    }

    match /contatos/{contatoId} {
      allow create: if request.resource.data.status == 'novo'
        && request.resource.data.keys().hasOnly([
          'usuarioId', 'nome', 'email', 'telefone', 'mensagem', 'status', 'criadoEm'
        ])
        && (
          (request.auth == null && request.resource.data.usuarioId == null)
          || (autenticado() && request.resource.data.usuarioId == request.auth.uid)
        )
        && textoValido(request.resource.data.nome, 3, 100)
        && textoValido(request.resource.data.email, 5, 254)
        && textoValido(request.resource.data.telefone, 0, 20)
        && textoValido(request.resource.data.mensagem, 10, 1000)
        && request.resource.data.criadoEm == request.time;

      allow read, delete: if administrador();
      allow update: if administrador()
        && request.resource.data.status in ['novo', 'respondido']
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm']);
    }

    match /configuracoes/{configuracaoId} {
      allow read: if configuracaoId == 'funcionamento';
      allow create, update: if configuracaoId == 'funcionamento' && administrador();
      allow delete: if false;
    }

    match /auditoria/{registroId} {
      allow read: if administrador();
      allow create: if administrador()
        && request.resource.data.keys().hasOnly([
          'adminUid', 'adminEmail', 'acao', 'entidade', 'entidadeId', 'detalhes', 'criadoEm'
        ])
        && request.resource.data.adminUid == request.auth.uid
        && emailDaConta(request.resource.data.adminEmail)
        && textoValido(request.resource.data.acao, 2, 80)
        && textoValido(request.resource.data.entidade, 2, 80)
        && textoValido(request.resource.data.entidadeId, 1, 180)
        && textoValido(request.resource.data.detalhes, 0, 2000)
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    match /solicitacoes_privacidade/{userId} {
      allow create: if autenticado()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'usuarioId', 'email', 'tipo', 'status', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.usuarioId == request.auth.uid
        && emailDaConta(request.resource.data.email)
        && request.resource.data.tipo == 'exclusao'
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      allow read: if administrador() || (autenticado() && request.auth.uid == userId);

      allow update: if (administrador()
        && request.resource.data.status in ['pendente', 'atendida']
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm', 'atualizadoPor']))
        || (autenticado()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'usuarioId', 'email', 'tipo', 'status', 'criadoEm', 'atualizadoEm'
          ])
          && request.resource.data.usuarioId == request.auth.uid
          && emailDaConta(request.resource.data.email)
          && request.resource.data.tipo == 'exclusao'
          && request.resource.data.status == 'pendente'
          && request.resource.data.criadoEm == request.time
          && request.resource.data.atualizadoEm == request.time);

      allow delete: if administrador();
    }

    match /horarios/{horarioId} {
      allow read: if resource.data.ativo == true || administrador();
      allow create, update: if administrador() && horarioValido(request.resource.data);
      allow delete: if administrador();
    }

    match /{colecao}/{documentoId} {
      allow read: if colecao in ['planos', 'professores']
        && (resource.data.ativo == true || administrador());
      allow create, update, delete: if colecao in ['planos', 'professores']
        && administrador();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
